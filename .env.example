# =============================================================================
# KhaiDai — environment variables
# =============================================================================
#
# This file lists every environment variable the application reads. Copy it
# to `.env` and fill in real values. **Never commit a real `.env`** — the
# gitignore already excludes it.
#
# Conventions
#   • `NEXT_PUBLIC_*` keys are exposed to the browser bundle. Everything
#     else stays server-side.
#   • `*_BASE_URL` keys are the public origin the app is reachable at
#     (used to rewrite payment-gateway callbacks).
#   • `*_BASE` keys are local-dev convenience overrides for the smoke/
#     probe scripts so a contributor can point them at a different host
#     without editing the scripts.
#
# =============================================================================
# Database
# =============================================================================
# Local Postgres connection string for Prisma. Format:
#   postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schemaName>
#
# ── Production (Vercel + Neon) ──────────────────────────────────────────────
# In production set `DATABASE_URL` to Neon's **pooled** connection string
# (the one with `-pooler` in the hostname and `?sslmode=require`). The
# serverless runtime keeps connections open only for the lifetime of a
# single request, so the pooler is what every API route talks to.
#
# Set `DIRECT_URL` to Neon's **unpooled** connection string (the
# plain `*.neon.tech` hostname, also `?sslmode=require`). Prisma's
# migrate / introspection / seed scripts use `DIRECT_URL` because
# the pooler cannot service long-lived migrations.
#
# See `prisma.config.ts` — `migrations.adapter` reads `DIRECT_URL`,
# `migrations.directUrl` ensures prisma still finds it, and the
# runtime singleton in `lib/prisma.ts` reads `DATABASE_URL`.
DATABASE_URL=postgresql://neondb_owner:npg_3XgdBKrMsuc0@ep-weathered-night-azqpxcbv-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://neondb_owner:npg_3XgdBKrMsuc0@ep-weathered-night-azqpxcbv.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# (Optional) Mirror of the password out of DATABASE_URL so plain `psql`
# and `pg_dump` can pick it up. The included scripts read this when
# available and fall back to parsing DATABASE_URL.
PGPASSWORD=CHANGEME


# =============================================================================
# Auth
# =============================================================================
# Secret used to sign + verify session JWTs. Treat this like a password;
# rotating it invalidates every existing session.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=2Quc32GNimy58WcE1EVGXQZkk7M3LhdSaTasbiG25OifYIPShw2O5koiKdTe15oy

# JWT lifetime. Anything parseable by `ms` works ("7d", "12h", "30m").
JWT_EXPIRES_IN=7d


# =============================================================================
# SSLCommerz (payment gateway)
# =============================================================================
# Sandbox credentials are issued by SSLCommerz after merchant signup.
# `SSLCZ_IS_SANDBOX=true` routes requests to the sandbox URL.
SSLCZ_STORE_ID="khaid6abe0d70e2e19"
SSLCZ_STORE_PASSWORD="khaid6abe0d70e2e19@ssl"
SSLCZ_IS_SANDBOX=true

# Public origin the app is reachable at. The success / fail / cancel /
# IPN URLs that SSLCommerz redirects to are derived from this base.
APP_BASE_URL=https://placeholder.vercel.app


# =============================================================================
# SMTP (transactional email)
# =============================================================================
# Gmail SMTP with an App Password (2FA must be enabled on the account
# and the token generated at https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.khaidai@gmail.com
# 16-character app password (not the account password).
SMTP_PASS=qtggrsvpowqvfpnz
# Optional: shown in the customer's mail client as the "From" name.
# Defaults to SMTP_USER when unset.
SMTP_FROM="KhaiDai <info.khaidai@gmail.com>"


# =============================================================================
# Public site config (exposed to the browser via NEXT_PUBLIC_*)
# =============================================================================
# Email address shown on the /contact and /safety pages. Falls back
# to the dev default when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=info.khaidai@gmail.com


# =============================================================================
# Probe / smoke scripts (local-dev convenience)
# =============================================================================
# Override the dev-server origin the probe and e2e scripts hit.
# Defaults to http://localhost:3000 when unset.
SMOKE_BASE_URL=http://localhost:3000
PROBE_BASE_URL=http://localhost:3000
TEST_BASE=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
PROBE_BASE=http://localhost:3000

# Seeded admin credentials (used by `_smoke_admin_*.ps1` and a few
# other dev-only helpers). The actual admin user must exist in the
# database — these are *credentials*, not account-creation triggers.
ADMIN_EMAIL=admin@example.com
ADMIN_PASS=CHANGEME


# =============================================================================
# Node / Next.js
# =============================================================================
# Default: 1.5 GB. Bump to 2048+ on memory-constrained dev machines.
NODE_OPTIONS=--max-old-space-size=1536
NEXT_TELEMETRY_DISABLED=1
# NODE_ENV is normally set by Next.js automatically (`development` for
# `next dev`, `production` for `next start`). Override only when you
# need to run a build under a specific environment.
# NODE_ENV=development

# Verbose Next.js logs when debugging the dev server. Example:
# DEBUG=next:router-server:filesystem
# DEBUG=


# =============================================================================
# Smoke-user passwords (read by probe and e2e scripts)
# -----------------------------------------------------------------------------
# These are NOT application secrets. The probe and e2e scripts sign
# in as seeded @khaidai.test users with a known password so the
# scripts can run without manual setup. Override only if you change
# the seeded passwords.
# =============================================================================
TEMP=CHANGEME
